{
  "printWidth": 180,               // max line length
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "jsxBracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "proseWrap": "preserve",
  "importOrder": ["^[./]"],         // sort imports (optional)
  "importOrderSeparation": false,
  "importOrderSortSpecifiers": true
}
